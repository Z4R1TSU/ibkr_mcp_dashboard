ACCESS_MODE=local
HOST=127.0.0.1
PORT=8048
PUBLIC_URL=http://127.0.0.1:8048
DATA_DIR=./data
POLL_SECONDS=60
QUOTE_BATCH_SIZE=4
STALE_SECONDS=180
SESSION_HOURS=8

# 首次打开 Discord 设置时使用的入市日期，可在看板中修改。
# Application ID 与启停开关保存在私有 DATA_DIR/discord.json。
DISCORD_START_DATE=

# 专用飞书应用，先通过 lark-cli config init --new --name ibkr-portfolio 创建
FEISHU_ENABLED=false
FEISHU_PROFILE=ibkr-portfolio
FEISHU_CLI_PATH=lark-cli
FEISHU_OWNER_OPEN_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_TIMEZONE=Asia/Shanghai
MEMORY_ENABLED=false

# 兼容 Chat Completions；BASE_URL 填含 /v1 的 API 基址
# 三项填齐后启用；仅在自由问答时向配置的模型服务发送账户快照
MODEL_PROVIDER=chat-completions
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=300
# AIDP 模式使用完整 crawl 地址（不含 ?ak=），密钥仍填 MODEL_API_KEY
# MODEL_PROVIDER=aidp
# MODEL_BASE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl
# MODEL_NAME=gpt-5.6-sol
MODEL_MAX_TOKENS=32768

# TradingAgents 仅在收到 /research 命令后运行，复用上述模型，绝不下单
# 首次安装：npm run research:setup（Python 3.11+）
TRADINGAGENTS_ENABLED=true
TRADINGAGENTS_TIMEOUT_SECONDS=1800
TRADINGAGENTS_MAX_CALLS=100
# 可选：独立 Python 环境的绝对路径，默认 .venv-tradingagents/bin/python
TRADINGAGENTS_PYTHON=
