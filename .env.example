ACCESS_MODE=local
HOST=127.0.0.1
PORT=8048
PUBLIC_URL=http://127.0.0.1:8048
DATA_DIR=./data
POLL_SECONDS=60
# 美东非交易时段（交易日 04:00–20:00 以外、周末、休市日）的后台读取间隔，按整点对齐，默认 6 小时。
CLOSED_POLL_SECONDS=21600
QUOTE_BATCH_SIZE=4
STALE_SECONDS=180
SESSION_HOURS=8
# IB 官方 MCP 和授权请求的可选 HTTP CONNECT 代理；留空直连，保留 TLS 校验。
IBKR_HTTP_PROXY=
# 令牌交换可单独使用稳定出口。未设置时沿用 IBKR_HTTP_PROXY；显式留空则直连。
# IBKR_TOKEN_HTTP_PROXY=

# 内网 HTTPS 可选：PUBLIC_URL 使用 https://私有IPv4:8443，后端仍绑定 127.0.0.1。
# ACCESS_MODE=intranet 可免看板密码；password 保持密码登录。
# 首次在 Mac 图形界面信任服务证书；8080 仅提供公开证书和安装步骤。
# INTRANET_HTTPS_CERT_FILE=./data/tls/server.crt
# INTRANET_HTTPS_KEY_FILE=./data/tls/server.key
# INTRANET_CERT_PORT=8080

# 首次打开 Discord 设置时使用的入市日期，可在看板中修改。
# Application ID 与启停开关保存在私有 DATA_DIR/discord.json。
DISCORD_START_DATE=
# remote 用于由 Mac 同步程序连接桌面端，local 用于同机 Discord。
# remote 支持 password 和 intranet；内网免密时 Mac 通过 HTTPS 直连。
DISCORD_TRANSPORT=local

# 专用飞书应用，先通过 lark-cli config init --new --name ibkr-portfolio 创建
FEISHU_ENABLED=false
FEISHU_PROFILE=ibkr-portfolio
FEISHU_CLI_PATH=lark-cli
FEISHU_OWNER_OPEN_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_TIMEZONE=Asia/Shanghai
# 日报网页估值采集：默认使用现有 Chromium，Linux 还需 Xvfb。
# 以下为空时自动查找当前安装；不需要行情 API 密钥。
DAILY_CHROMIUM_PATH=
DAILY_XVFB_PATH=
DAILY_BROWSER_LIBRARY_PATH=
MEMORY_ENABLED=false
MEMORY_MAX_TURNS=20
MEMORY_MAX_CHARS=200000

# 兼容 Chat Completions；BASE_URL 填含 /v1 的 API 基址
# 三项填齐后启用；仅在自由问答时向配置的模型服务发送账户快照
MODEL_PROVIDER=chat-completions
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=300
# 单次输入预算：按 token 估算，包含账户信息与完整历史消息。
MODEL_CONTEXT_TOKENS=100000
# AIDP 模式使用完整 crawl 地址（不含 ?ak=），密钥仍填 MODEL_API_KEY
# MODEL_PROVIDER=aidp
# MODEL_BASE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl
# MODEL_NAME=gpt-5.6-sol
MODEL_MAX_TOKENS=32768

# TradingAgents 仅在收到 /research 命令后运行，复用上述模型，绝不下单
# 首次安装：npm run research:setup（Python 3.12+）
TRADINGAGENTS_ENABLED=true
TRADINGAGENTS_TIMEOUT_SECONDS=1800
TRADINGAGENTS_MAX_CALLS=100
# 可选：独立 Python 环境的绝对路径，默认 .venv-tradingagents/bin/python
TRADINGAGENTS_PYTHON=
# 研究数据配置；不向 Python 子进程开放 IB、飞书或真实模型密钥。
FRED_API_KEY=
# SEC 自动请求标识，可填写应用名称与联系邮箱；未设置沿用固定版本 SDK 标识。
SEC_EDGAR_USER_AGENT=
# 使用已有授权数据源；Alpha Vantage 复权日线需对应 API 权限及配额。
MARKET_DATA_PRIMARY=thinkorswim
TRADINGAGENTS_MARKET_VENDOR=thinkorswim
TRADINGAGENTS_MARKET_FALLBACK=yfinance
# 可选的 thinkorswim 只读采集器；需先通过看板 /tos-login/ 登录。
# TOS_DATA_DIR=./data/thinkorswim
# TOS_PORT=8051
# TOS_HTTP_PROXY=（默认复用现有研究/IB 网络代理）
# TOS_HISTORY_RANGE=YEAR5
# TOS_HISTORY_ADJUSTMENT=unknown
# TOS_OPTION_EXPIRY=2026-10-23
# TOS_OPTION_STRIKES=10
# TOS_MARKET_URL=http://127.0.0.1:8051
# 嘉信日线未通过口径、样本与时效检查时自动回退。不要把 Schwab token 写入环境变量。
TRADINGAGENTS_NEWS_VENDOR=yfinance
# NEWS_SENTIMENT 当前实测要求付费订阅；普通免费 Key 保持此项为空。
# 如已有相应接口授权，可填写 Key；程序仍保守限制滚动24小时25次。
ALPHA_VANTAGE_API_KEY=
# 可选研究数据 HTTP(S) 代理；本机模型桥接始终绕过代理。
TRADINGAGENTS_HTTP_PROXY=
